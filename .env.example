# ==============================================================================
# MEDICAL VR TRAINING BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

APP_NAME="Medical VR Training Backend"
APP_VERSION="1.0.0"
DEBUG=True

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Local SQLite (default for zero-dependency standalone operation)
DATABASE_URL="sqlite:///./medical_vr.db"

# Option B: Production PostgreSQL
# DATABASE_URL="postgresql+psycopg2://postgres:MedicalVR123@localhost:5432/medical_vr"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY="medical_vr_super_secret_key_change_this"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# EXTERNAL MEDICAL LLM SERVICE (PROJECT B)
# ------------------------------------------------------------------------------
# URL of the separate Medical LLM service running on port 8000
MEDICAL_LLM_URL="http://127.0.0.1:8000"
MEDICAL_LLM_ENDPOINT="/ask"
MEDICAL_LLM_MODEL="openbiollm"
MEDICAL_LLM_TIMEOUT=30

